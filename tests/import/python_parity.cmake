# The native importer and tools/disc/extract_disc.py must write byte-identical layout.txt,
# iso_meta.bin and fs/ for the same disc. Runs both on test_importer's synthetic disc.
# (The same check on a real dump: tools/disc/verify_import.sh.)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed (${rc}): ${err}")
    endif()
endfunction()

run("${TEST_IMPORTER}" --write-image "${WORK}/disc.bin")
run("${PYTHON}" "${EXTRACT_DISC}" "${WORK}/disc.bin" -o "${WORK}/python")
run("${TEST_IMPORTER}" --import "${WORK}/disc.bin" "${WORK}/native")
set(native "${WORK}/native/SLPS-99999")

file(GLOB_RECURSE py_files RELATIVE "${WORK}/python" "${WORK}/python/fs/*")
file(GLOB_RECURSE native_files RELATIVE "${native}" "${native}/*")
list(APPEND py_files layout.txt iso_meta.bin)
list(SORT py_files)
list(SORT native_files)
if(NOT py_files STREQUAL native_files)
    message(FATAL_ERROR "different file sets:\n  python: ${py_files}\n  native: ${native_files}")
endif()
foreach(f IN LISTS py_files)
    execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/python/${f}" "${native}/${f}" RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "${f} differs between extract_disc.py and the native importer")
    endif()
endforeach()
list(LENGTH py_files n)
message(STATUS "${n} files byte-identical")
