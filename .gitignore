# Copyrighted inputs and everything derived from them: never commit.
/disc
/bios/
/extracted
/saves/
/assets/raw/*
/assets/converted/*
/assets/*.pak
# per-serial local data: disc overrides, loose files, movie sources
/assets/*-*/
/generated/*
!**/.gitkeep

# Ghidra databases (share symbols via ghidra/symbols exports instead)
/ghidra/project/*
# Ghidra itself (a local dependency: unpack the release zip here)
/ghidra/ghidra_*_PUBLIC/
*.lock
*.lock~

# Build
/build/
/out/
compile_commands.json
.cache/
__pycache__/
/logs/

# Claude Code agent worktrees
/.claude/worktrees/
/dist/

# Local PC options (created on first run; ./settings.ini is found first)
/settings.ini
# Player cheat files (template: docs/cheats.example.txt)
/cheats/
