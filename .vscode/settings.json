{
  // CMake Tools drives the presets in CMakePresets.json.
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,

  // clangd reads the compile database of the dev build.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/linux-debug",
    "--background-index",
    "--header-insertion=never"
  ],
  "C_Cpp.intelliSenseEngine": "disabled",

  // Generated C (~150k lines), disc data, ripped assets and the Ghidra install are huge (and
  // gitignored): keep them out of search and watchers; the Ghidra install is hidden entirely.
  "search.exclude": {
    "build/**": true,
    "generated/**": true,
    "extracted/**": true,
    "disc/**": true,
    "assets/**": true,
    "ghidra/project/**": true,
    "ghidra/ghidra_*_PUBLIC/**": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/generated/**": true,
    "**/extracted/**": true,
    "**/disc/**": true,
    "**/assets/**": true,
    "**/ghidra/project/**": true,
    "**/ghidra/ghidra_*_PUBLIC/**": true
  },
  "files.exclude": {
    "ghidra/ghidra_*_PUBLIC": true
  },
  "files.associations": { "*.sinc": "plaintext" }
}
